# ---------- Server ----------
PORT=8081
NODE_ENV=development

# ---------- Database / Redis (docker compose up -d) ----------
# Host ports are 5433 / 6380 so this project can run next to the main Aegis project (5432 / 6379).
DATABASE_URL="postgresql://aegis:aegis_password@localhost:5433/aegis_majorp"
REDIS_URL="redis://localhost:6380"

# ---------- Secrets (generate your own!) ----------
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=""
JWT_EXPIRES_IN="7d"
# Exactly 64 hex chars (32 bytes). Used for AES-256-GCM encryption of provider keys.
# If you lose or change it, every stored provider key becomes unreadable.
ENCRYPTION_KEY=""

# ---------- Semantic cache ----------
EMBEDDING_SERVICE_URL="http://localhost:8002"
EMBEDDING_TIMEOUT_MS=4000
CACHE_ENABLED=true
CACHE_TTL_SECONDS=86400
CACHE_MAX_ENTRIES_PER_SCOPE=500
# Hybrid rule: HIT if similarity >= STRONG, OR (similarity >= WEAK AND keyword overlap >= KEYWORD_MIN)
CACHE_SIM_STRONG=0.90
CACHE_SIM_WEAK=0.65
CACHE_KEYWORD_MIN=0.5

# ---------- Providers ----------
# NOTE: there are NO provider API keys here on purpose (BYOK). Each organization adds its own
# via POST /provider-keys. Only base URLs are configurable (Ollama needs no key).
OLLAMA_BASE_URL="http://localhost:11434"
# Optional overrides (proxies / offline mock server). Leave unset for the real APIs.
# OPENAI_BASE_URL="https://api.openai.com"
# ANTHROPIC_BASE_URL="https://api.anthropic.com"
# GEMINI_BASE_URL="https://generativelanguage.googleapis.com"
